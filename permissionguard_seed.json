  "policies": [
    {
      "id": "POL-READ-01",
      "name": "SAFE_READ_OPERATIONS",
      "description": "Permits autonomous read-only operations targeting certified non-sensitive resources and documentation repositories.",
      "scope": "RESOURCE_READ",
      "ruleType": "ALLOW_LIST",
      "riskThreshold": "LOW",
      "priority": 10,
      "enabled": true,
      "rules": [
        {
          "id": "RULE-R01",
          "name": "Public & Verified Internal Repos",
          "condition": "resource.path MATCHES \"s3://knowledge-base/*\" OR \"doc://enterprise/*\"",
          "actionOutcome": "ALLOW",
          "explanation": "Resource belongs to the certified low-risk enterprise knowledge base."
        },
        {
          "id": "RULE-R02",
          "name": "Exclude Vault & PII Buckets",
          "condition": "resource.path CONTAINS \"pii\" OR \"credential\" OR \"vault\"",
          "actionOutcome": "DENY",
          "explanation": "Read access to cryptographic vault or raw PII records is strictly blocked by read baseline."
        }
      ],
      "defaultDecision": "REQUIRE_APPROVAL",
      "lastUpdated": "2026-10-21 14:30 UTC"
    },
    {
      "id": "POL-EMAIL-02",
      "name": "SENSITIVE_OUTBOUND_COMMUNICATION",
      "description": "Enforces human authorization whenever an agent attempts to transmit emails to external domains or large distribution lists.",
      "scope": "EXTERNAL_COMMUNICATION",
      "ruleType": "CONTEXTUAL_HEURISTIC",
      "riskThreshold": "MEDIUM",
      "priority": 30,
      "enabled": true,
      "rules": [
        {
          "id": "RULE-E01",
          "name": "Internal Domain Whitelist",
          "condition": "recipient.domain == \"internal.enterprise.com\" AND recipient.count == 1",
          "actionOutcome": "ALLOW",
          "explanation": "Single recipient within verified internal organizational boundary."
        },
        {
          "id": "RULE-E02",
          "name": "External or Bulk Outreach",
          "condition": "recipient.domain != \"internal.enterprise.com\" OR recipient.count > 5",
          "actionOutcome": "REQUIRE_APPROVAL",
          "explanation": "Outbound dispatch targets external entities or broad recipient list; human verification required."
        },
        {
          "id": "RULE-E03",
          "name": "Mass Email Guardrail",
          "condition": "recipient.count > 500",
          "actionOutcome": "DENY",
          "explanation": "Bulk broadcast exceeding 500 recipients exceeds autonomous agent threshold."
        }
      ],
      "defaultDecision": "REQUIRE_APPROVAL",
      "lastUpdated": "2026-10-22 09:15 UTC"
    },
    {
      "id": "POL-IAM-03",
      "name": "RESTRICTED_PERMISSION_CHANGES",
      "description": "Strictly governs identity role modifications, credential issuance, and security boundary adjustments.",
      "scope": "ACCESS_CONTROL",
      "ruleType": "DENY_LIST",
      "riskThreshold": "CRITICAL",
      "priority": 100,
      "enabled": true,
      "rules": [
        {
          "id": "RULE-I01",
          "name": "Privilege Escalation Block",
          "condition": "operation == \"iam:AttachUserPolicy\" OR \"iam:PutUserPolicy\" OR role == \"AdministratorAccess\"",
          "actionOutcome": "DENY",
          "explanation": "Autonomous modification of administrative IAM roles is prohibited under Zero Trust policy."
        },
        {
          "id": "RULE-I02",
          "name": "Temporary Token Review",
          "condition": "operation == \"sts:AssumeRole\" AND duration <= 3600",
          "actionOutcome": "REQUIRE_APPROVAL",
          "explanation": "Short-lived role assumption requires security engineer sign-off."
        }
      ],
      "defaultDecision": "DENY",
      "lastUpdated": "2026-10-20 18:00 UTC"
    },
    {
      "id": "POL-EXPORT-04",
      "name": "SENSITIVE_DATA_EXPORT",
      "description": "Controls bulk exfiltration, customer CSV downloads, and analytical exports exceeding baseline limits.",
      "scope": "DATA_EXFILTRATION",
      "ruleType": "RISK_THRESHOLD",
      "riskThreshold": "HIGH",
      "priority": 50,
      "enabled": true,
      "rules": [
        {
          "id": "RULE-X01",
          "name": "High-Volume Row Extraction",
          "condition": "rowsExported > 1000 OR containsFinancialData == true",
          "actionOutcome": "REQUIRE_APPROVAL",
          "explanation": "Data payload contains >1,000 sensitive records or financial fields; requires compliance signoff."
        },
        {
          "id": "RULE-X02",
          "name": "Unencrypted Destination",
          "condition": "destination.encrypted == false",
          "actionOutcome": "DENY",
          "explanation": "Egress to unencrypted object targets is permanently prohibited."
        }
      ],
      "defaultDecision": "REQUIRE_APPROVAL",
      "lastUpdated": "2026-10-22 16:40 UTC"
    },
    {
      "id": "POL-DB-05",
      "name": "BATCH_DATABASE_MUTATION",
      "description": "Requires human approval before agents execute bulk SQL writes, schema drops, or high-cardinality updates.",
      "scope": "DATABASE_WRITE",
      "ruleType": "RISK_THRESHOLD",
      "riskThreshold": "HIGH",
      "priority": 40,
      "enabled": true,
      "rules": [
        {
          "id": "RULE-D01",
          "name": "Mass Record Mutation",
          "condition": "mutation.type == \"UPDATE\" AND estimatedRows > 50",
          "actionOutcome": "REQUIRE_APPROVAL",
          "explanation": "Batch mutation impacts 50+ database rows; requires operational approval."
        },
        {
          "id": "RULE-D02",
          "name": "Destructive DDL Block",
          "condition": "mutation.statement CONTAINS \"DROP\" OR \"TRUNCATE\"",
          "actionOutcome": "DENY",
          "explanation": "Destructive DDL statements are blocked unconditionally for AI agents."
        }
      ],
      "defaultDecision": "REQUIRE_APPROVAL",
      "lastUpdated": "2026-10-19 11:20 UTC"
    },
    {
      "id": "POL-REVIEW-06",
      "name": "UNCLASSIFIED_ACTION_REVIEW",
      "description": "Routes supported action categories without a dedicated allow rule to a human reviewer.",
      "scope": "UNCLASSIFIED_ACTIONS",
      "ruleType": "CONTEXTUAL_HEURISTIC",
      "riskThreshold": "MEDIUM",
      "priority": 20,
      "enabled": true,
      "rules": [
        {
          "id": "RULE-DEFAULT-REVIEW",
          "name": "Unclassified Action Review",
          "condition": "action.category HAS NO DEDICATED AUTONOMOUS ALLOW RULE",
          "actionOutcome": "REQUIRE_APPROVAL",
          "explanation": "Actions without a dedicated allow rule wait for human review."
        }
      ],
      "defaultDecision": "REQUIRE_APPROVAL",
      "lastUpdated": "2026-10-23 10:30 UTC"
    }
  ],
